<%# locals: (transactions:) -%>
<%= render layout: "shared/panel", locals: { title: "Recent transactions", css: "min-w-0" } do %>
  <% if transactions.any? %>
    <div class="overflow-x-auto">
      <table class="data-table data-table-compact">
        <thead>
          <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Account</th>
            <th>Category</th>
            <th class="text-right">Amount</th>
          </tr>
        </thead>
        <tbody>
          <% transactions.each do |transaction| %>
            <tr>
              <td class="whitespace-nowrap text-mint-muted"><%= short_date transaction.transaction_date %></td>
              <td class="font-semibold"><span class="block max-w-44 truncate" title="<%= transaction.description %>"><%= transaction.description %></span></td>
              <td><%= link_to transaction.account.name, transaction.account, class: "btn-link block max-w-36 truncate font-normal" %></td>
              <td class="<%= "text-mint-faint" unless transaction.category %>"><span class="block max-w-32 truncate"><%= transaction.category&.name || "Uncategorized" %></span></td>
              <td class="text-right"><%= amount_tag transaction.amount %></td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% else %>
    <p class="panel-empty">No transactions yet.</p>
  <% end %>
<% end %>
