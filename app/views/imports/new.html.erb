<% content_for :title, "Import CSV" %>

<h1>Import transactions into <%= @account.name %></h1>

<p>Upload a CSV file with a header row of <code>date,description,amount</code>, for example:</p>

<pre>date,description,amount
2026-09-01,Loblaws,-54.32
2026-09-02,Payroll,2500.00</pre>

<p>Dates use YYYY-MM-DD. Amounts are negative for money out and positive for money in. If any row is invalid, nothing is imported.</p>

<%= form_with url: account_imports_path(@account) do |form| %>
  <% if @import.errors.any? %>
    <ul>
      <% @import.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <% if @import.row_errors.any? %>
    <table>
      <thead>
        <tr>
          <th>Line</th>
          <th>Row</th>
          <th>Problems</th>
        </tr>
      </thead>
      <tbody>
        <% @import.row_errors.each do |row_error| %>
          <tr>
            <td><%= row_error[:line] %></td>
            <td><code><%= row_error[:row] %></code></td>
            <td>
              <ul>
                <% row_error[:messages].each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <div>
    <%= form.label :file, "CSV file" %>
    <%= form.file_field :file, accept: ".csv,text/csv" %>
  </div>

  <%= form.submit "Import" %>
<% end %>

<%= link_to "Back to #{@account.name}", @account %>
