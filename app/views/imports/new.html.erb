<% content_for :title, "Import CSV" %>

<div class="mx-auto max-w-3xl space-y-6">
  <%= render "shared/page_header", title: "Import transactions", subtitle: @account.name %>

  <%= render layout: "shared/card", locals: { title: "Your bank's CSV export" } do %>
    <div class="space-y-3 p-5 text-sm">
      <p>Upload the CSV file your bank or credit card exports. Common layouts are recognized automatically: with or without a header row, one amount column or separate money out and money in columns.</p>
      <p class="text-mint-muted">If we're not sure how to read a file, you'll see a preview to check the columns first. Transactions that were already imported are skipped, so overlapping exports are fine.</p>
    </div>
  <% end %>

  <%= render layout: "shared/card", locals: { title: "Upload" } do %>
    <%= form_with url: account_imports_path(@account), class: "space-y-5 p-5" do |form| %>
      <%= render "shared/form_errors", record: @import %>

      <div>
        <%= form.label :file, "CSV file", class: "form-label" %>
        <%= form.file_field :file, accept: ".csv,text/csv", class: "form-input file:mr-4 file:cursor-pointer file:rounded-[2px] file:border-0 file:bg-mint-blue file:px-3 file:py-1 file:text-sm file:font-extrabold file:text-white" %>
      </div>

      <div class="flex items-center gap-2 text-sm">
        <%= form.check_box :review %>
        <%= form.label :review, "Let me check the columns before importing" %>
      </div>

      <div class="flex items-center justify-between gap-4 pt-2">
        <%= link_to "Cancel", @account, class: "btn-link text-sm" %>
        <%= form.submit "Import", class: "btn btn-primary" %>
      </div>
    <% end %>
  <% end %>
</div>
