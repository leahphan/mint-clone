<% content_for :title, "New transaction" %>

<h1>New transaction for <%= @account.name %></h1>

<%= form_with model: [ @account, @transaction ] do |form| %>
  <% if @transaction.errors.any? %>
    <ul>
      <% @transaction.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  <% end %>

  <div>
    <%= form.label :transaction_date, "Date" %>
    <%= form.date_field :transaction_date %>
  </div>

  <div>
    <%= form.label :description %>
    <%= form.text_field :description %>
  </div>

  <div>
    <%= form.label :amount %>
    <%= form.number_field :amount, step: "0.01" %>
    <small>Negative for money out, positive for money in.</small>
  </div>

  <%= form.submit "Add transaction" %>
<% end %>

<%= link_to "Back to #{@account.name}", @account %>
