<% content_for :title, "Categories" %>

<%= render "shared/page_header", title: "Categories", subtitle: "Group your transactions so you can see where your money goes." %>

<div class="grid gap-5 lg:grid-cols-[1fr_18rem]">
  <%= render layout: "shared/panel", locals: { title: "Your categories", meta: pluralize(@categories.size, "category") } do %>
    <% if @categories.any? %>
      <ul class="panel-list">
        <% @categories.each do |category| %>
          <li>
            <span class="truncate font-semibold"><%= category.name %></span>
            <span class="flex shrink-0 items-center gap-3">
              <span class="text-mint-muted"><%= category.category_type.humanize %></span>
              <%= link_to "Edit", edit_category_path(category), class: "btn-link" %>
            </span>
          </li>
        <% end %>
      </ul>
    <% else %>
      <%= render "shared/empty_state", title: "No categories yet", message: "Add your first one, like Groceries or Rent." %>
    <% end %>
  <% end %>

  <%= render layout: "shared/panel", locals: { title: "New category", css: "self-start" } do %>
    <%= render "form", category: @category, submit_label: "Create category" %>
  <% end %>
</div>
