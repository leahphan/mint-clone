<%# locals: (title:, subtitle: nil) -%>
<section class="bg-linear-to-br from-mint-hero to-mint-hero/85 text-white">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <h1 class="text-3xl font-black tracking-tight text-white sm:text-4xl"><%= title %></h1>
    <% if subtitle %>
      <p class="mt-2 max-w-2xl text-lg font-light text-white/80"><%= subtitle %></p>
    <% end %>
    <%= yield %>
  </div>
</section>
