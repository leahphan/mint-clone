<% content_for :title, @account.name %>

<%= render "shared/page_header", title: @account.name, subtitle: @account.account_type.humanize do %>
  <%= link_to "Edit", edit_account_path(@account), class: "btn btn-secondary" %>
  <%= link_to "Import CSV", new_account_import_path(@account), class: "btn btn-secondary" %>
  <%= link_to "Add transaction", new_account_transaction_path(@account), class: "btn btn-primary" %>
<% end %>

<%# Reloads by itself while new transactions are being categorized (shared/categorizing). -%>
<%= turbo_frame_tag "account_transactions", target: "_top", refresh: "morph", class: "block space-y-5" do %>
  <%= render "shared/categorizing" if @categorizing_import_ids.any? %>

  <section class="panel stat-strip max-w-md sm:grid-cols-2" aria-label="Account summary">
    <%= render layout: "shared/stat", locals: { label: "Balance" } do %>
      <%= amount_tag @account.balance %>
    <% end %>
    <%= render layout: "shared/stat", locals: { label: "Transactions" } do %>
      <span class="font-semibold tabular-nums"><%= @transactions.size %></span>
    <% end %>
  </section>

  <%= render layout: "shared/panel", locals: { title: "Transactions" } do %>
    <div class="overflow-x-auto">
      <table class="data-table data-table-compact">
        <thead>
          <tr>
            <th>Date</th>
            <th>Description</th>
            <th>Category</th>
            <th class="text-right">Amount</th>
            <th><span class="sr-only">Actions</span></th>
          </tr>
        </thead>
        <tbody>
          <% @transactions.each do |transaction| %>
            <tr>
              <td class="whitespace-nowrap text-mint-muted"><%= short_date transaction.transaction_date %></td>
              <td class="font-semibold"><span class="block max-w-96 truncate" title="<%= transaction.description %>"><%= transaction.description %></span><% if transaction.possible_duplicate? %><span class="block text-xs font-normal text-mint-negative">Possible duplicate</span><% end %></td>
              <td class="<%= "text-mint-faint" unless transaction.category %>"><span class="block max-w-48 truncate"><%= category_label transaction, @categorizing_import_ids %></span></td>
              <td class="text-right"><%= amount_tag transaction.amount %></td>
              <td class="text-right"><%= link_to "Edit", edit_account_transaction_path(@account, transaction), class: "btn-link" %></td>
            </tr>
          <% end %>
          <%# The opening balance comes before every transaction, so it's the last row when newest first. -%>
          <tr>
            <td></td>
            <td class="font-semibold">Opening balance</td>
            <td></td>
            <td class="text-right"><%= amount_tag @account.opening_balance %></td>
            <td class="text-right"><%= link_to "Edit", edit_account_path(@account), class: "btn-link" %></td>
          </tr>
        </tbody>
      </table>
    </div>
  <% end %>
<% end %>
