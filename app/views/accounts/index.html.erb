<% content_for :title, "Accounts" %>

<%= render "shared/page_header", title: "Accounts" do %>
  <%= link_to "Add account", new_account_path, class: "btn btn-primary" %>
<% end %>

<% if @accounts.any? %>
  <div class="space-y-5">
    <% Account.grouped(@accounts).each do |group, group_accounts| %>
      <%= render layout: "shared/panel", locals: { title: group, meta: amount_tag(group_accounts.sum(0, &:balance)) } do %>
        <div class="overflow-x-auto">
          <table class="data-table data-table-compact">
            <thead>
              <tr>
                <th>Account</th>
                <th class="w-40">Type</th>
                <th class="w-36 text-right">Balance</th>
              </tr>
            </thead>
            <tbody>
              <% group_accounts.each do |account| %>
                <tr>
                  <td><%= link_to account.name, account, class: "btn-link block max-w-80 truncate" %></td>
                  <td class="whitespace-nowrap text-mint-muted"><%= account.account_type.humanize %></td>
                  <td class="text-right"><%= amount_tag account.balance %></td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <%= render layout: "shared/panel" do %>
    <%= render "shared/empty_state", title: "No accounts yet",
      message: "Add a chequing, savings or credit card account to start tracking transactions." do %>
      <%= link_to "Add your first account", new_account_path, class: "btn btn-primary" %>
    <% end %>
  <% end %>
<% end %>
