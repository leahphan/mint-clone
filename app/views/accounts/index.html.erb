<% content_for :title, "Accounts" %>

<h1>Accounts</h1>

<% if @accounts.any? %>
  <ul>
    <% @accounts.each do |account| %>
      <li><%= link_to account.name, account %> (<%= account.account_type.humanize %>)</li>
    <% end %>
  </ul>
<% else %>
  <p>No accounts yet.</p>
<% end %>

<%= link_to "New account", new_account_path %>
