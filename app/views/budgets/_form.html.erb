<%# locals: (budget:, categories: nil, submit_label:) -%>
<%= form_with model: budget, class: "panel-body space-y-4" do |form| %>
  <%= render "shared/form_errors", record: budget %>

  <div>
    <%= form.label :category_id, "Category", class: "form-label" %>
    <% if budget.new_record? %>
      <%= form.select :category_id, categories.map { |category| [ "#{category.name} (#{category.category_type})", category.id ] },
        { include_blank: true }, class: "form-input" %>
    <% else %>
      <p class="py-1.5 text-sm font-semibold"><%= budget.category.name %> <span class="font-normal text-mint-muted">(<%= budget.category_type %>)</span></p>
    <% end %>
  </div>

  <div>
    <%= form.label :amount, "Monthly amount", class: "form-label" %>
    <%= form.number_field :amount, step: "0.01", min: "0.01", class: "form-input", placeholder: "500.00" %>
    <p class="form-hint">A monthly spending limit for an expense category, or a monthly goal for an income category. Refunds and reversals are netted out.</p>
  </div>

  <div class="flex items-center justify-between gap-4 pt-1">
    <%= link_to "Cancel", budgets_path, class: "btn-link text-sm" %>
    <%= form.submit submit_label, class: "btn btn-primary" %>
  </div>
<% end %>
