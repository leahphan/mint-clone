# Local development settings. Copy to .env and adjust: cp .env.example .env
# .env is gitignored, so real secrets go there, never in this file.
# Loaded in development only (dotenv); tests don't read it.

# AI fallback for transaction categorization, using Ollama Cloud (no local install).
# Create an API key at https://ollama.com/settings/keys and put it in .env.
# Without a key, AI categorization is skipped and transactions stay uncategorized.
AI_CATEGORIZATION_ENABLED=false
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com
# Model name as listed by https://ollama.com/api/tags (gemma4:31b is on the free plan).
OLLAMA_MODEL=gemma4:31b
