#!/usr/bin/env ruby
# Keeps a running QA Codespace on the latest origin/staging: checks once a minute and runs
# bin/codespace-qa-start when staging has moved. Started by bin/codespace-qa-start; only one runs at a time.
require "fileutils"

APP_ROOT = File.expand_path("..", __dir__)
BRANCH = "staging"
INTERVAL = Integer(ENV.fetch("QA_WATCH_INTERVAL", 60))

FileUtils.chdir APP_ROOT
exit unless ENV["CODESPACES"] == "true"

lock = File.open("tmp/pids/qa-watch.lock", File::RDWR | File::CREAT)
exit unless lock.flock(File::LOCK_EX | File::LOCK_NB)

LOG = File.open("log/qa-watch.log", "a")
LOG.sync = true

def say(message)
  LOG.puts "[#{Time.now.strftime('%F %T')}] #{message}"
end

say "Watching origin/#{BRANCH} every #{INTERVAL}s"
last_tried = nil

loop do
  sleep INTERVAL
  next unless `git branch --show-current`.strip == BRANCH

  unless system("git", "fetch", "-q", "origin", "+refs/heads/#{BRANCH}:refs/remotes/origin/#{BRANCH}", out: LOG, err: LOG)
    say "git fetch failed; trying again in #{INTERVAL}s"
    next
  end

  # Try each new staging commit once, so a broken commit doesn't restart Rails every minute.
  remote = `git rev-parse origin/#{BRANCH}`.strip
  next if remote == `git rev-parse HEAD`.strip || remote == last_tried
  last_tried = remote

  say "origin/#{BRANCH} moved to #{remote[0, 7]}; refreshing"
  if system({ "QA_SYNCED" => nil }, "bin/codespace-qa-start", in: File::NULL, out: LOG, err: LOG)
    say "Refreshed"
  else
    say "Refresh failed; see log/codespace.log"
  end
end
