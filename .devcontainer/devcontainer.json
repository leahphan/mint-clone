// For format details, see https://containers.dev/implementors/json_reference/
{
  "name": "mint",
  "dockerComposeFile": "compose.yaml",
  "service": "rails-app",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}",

  // Ruby comes from the image (matches .ruby-version). The app uses importmap and
  // the standalone Tailwind CLI, so no Node or Yarn is needed.
  "features": {
    "ghcr.io/rails/devcontainer/features/postgres-client:1": {}
  },

  "containerEnv": {
    // libpq reads these, so config/database.yml needs no changes.
    "PGHOST": "postgres",
    "PGUSER": "postgres"
  },

  // Private by default; Codespaces forwards it to https://<codespace>-3000.app.github.dev.
  "forwardPorts": [3000],
  "portsAttributes": {
    "3000": {
      "label": "Rails",
      "onAutoForward": "notify"
    }
  },

  // Runs on every start/resume: syncs to origin/staging (QA Codespace only), installs gems,
  // prepares the database and starts Rails in the background. Output: log/codespace.log.
  "postStartCommand": "bin/codespace-qa-start"
}
